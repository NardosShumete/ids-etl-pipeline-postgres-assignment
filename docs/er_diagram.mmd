erDiagram
    %% =========================================================================
    %% Entity-Relationship Diagram for CIC-IDS-2017 Intrusion Detection Pipeline
    %% =========================================================================

    attack_types {
        smallserial id PK "Surrogate Primary Key"
        varchar label UK "Flow label (e.g. BENIGN, DoS Hulk, DDoS)"
        varchar category "High-level threat class (e.g. DoS, PortScan)"
        boolean is_malicious "Flag indicating adversary traffic"
        text description "Detailed description of attack mechanism"
    }

    source_files {
        serial id PK "Surrogate Primary Key"
        varchar file_name UK "CSV file name (e.g. Monday-WorkingHours.pcap_ISCX.csv)"
        varchar capture_day "Capture weekday (e.g. Monday, Tuesday)"
        bigint row_count "Total flow records extracted"
        timestamptz imported_at "Ingestion timestamp"
    }

    flows {
        bigserial id PK "Surrogate Primary Key"
        integer source_file_id FK "Reference to source_files.id"
        smallint attack_type_id FK "Reference to attack_types.id"
        integer destination_port "Target service port (0-65535)"
        bigint flow_duration "Flow duration in microseconds"
        bigint total_fwd_packets "Forward packet count"
        bigint total_bwd_packets "Backward packet count"
        bigint total_length_of_fwd_packets "Total bytes in forward direction"
        bigint total_length_of_bwd_packets "Total bytes in backward direction"
        double_precision flow_bytes_per_s "Transfer throughput (bytes/s)"
        double_precision flow_packets_per_s "Packet rate (packets/s)"
        double_precision flow_iat_mean "Mean inter-arrival time"
        double_precision flow_iat_std "Standard deviation of IAT"
        double_precision flow_iat_max "Maximum IAT"
        double_precision flow_iat_min "Minimum IAT"
        smallint fin_flag_count "FIN flag count"
        smallint syn_flag_count "SYN flag count"
        smallint rst_flag_count "RST flag count"
        smallint psh_flag_count "PSH flag count"
        smallint ack_flag_count "ACK flag count"
        smallint urg_flag_count "URG flag count"
        smallint cwe_flag_count "CWE flag count"
        smallint ece_flag_count "ECE flag count"
        double_precision down_up_ratio "Download / upload packet ratio"
        double_precision average_packet_size "Average packet size across flow"
    }

    flow_statistics {
        bigint flow_id PK, FK "1:1 Reference to flows.id"
        double_precision fwd_packet_length_max "Max forward packet size"
        double_precision fwd_packet_length_min "Min forward packet size"
        double_precision fwd_packet_length_mean "Mean forward packet size"
        double_precision fwd_packet_length_std "Std deviation forward packet size"
        double_precision bwd_packet_length_max "Max backward packet size"
        double_precision bwd_packet_length_min "Min backward packet size"
        double_precision bwd_packet_length_mean "Mean backward packet size"
        double_precision bwd_packet_length_std "Std deviation backward packet size"
        double_precision min_packet_length "Overall min packet length"
        double_precision max_packet_length "Overall max packet length"
        double_precision packet_length_mean "Overall mean packet length"
        double_precision packet_length_std "Overall std dev packet length"
        double_precision packet_length_variance "Overall variance of packet length"
        double_precision fwd_iat_total "Total forward IAT"
        double_precision fwd_iat_mean "Mean forward IAT"
        double_precision fwd_iat_std "Std dev forward IAT"
        double_precision fwd_iat_max "Max forward IAT"
        double_precision fwd_iat_min "Min forward IAT"
        double_precision bwd_iat_total "Total backward IAT"
        double_precision bwd_iat_mean "Mean backward IAT"
        double_precision bwd_iat_std "Std dev backward IAT"
        double_precision bwd_iat_max "Max backward IAT"
        double_precision bwd_iat_min "Min backward IAT"
        smallint fwd_psh_flags "Forward PSH flags"
        smallint bwd_psh_flags "Backward PSH flags"
        smallint fwd_urg_flags "Forward URG flags"
        smallint bwd_urg_flags "Backward URG flags"
        bigint fwd_header_length "Forward header length in bytes"
        bigint bwd_header_length "Backward header length in bytes"
        double_precision fwd_packets_per_s "Forward packets per second"
        double_precision bwd_packets_per_s "Backward packets per second"
        double_precision avg_fwd_segment_size "Avg forward segment size"
        double_precision avg_bwd_segment_size "Avg backward segment size"
        bigint fwd_header_length_1 "Duplicate forward header metric"
        double_precision fwd_avg_bytes_bulk "Avg forward bytes per bulk"
        double_precision fwd_avg_packets_bulk "Avg forward packets per bulk"
        double_precision fwd_avg_bulk_rate "Avg forward bulk transfer rate"
        double_precision bwd_avg_bytes_bulk "Avg backward bytes per bulk"
        double_precision bwd_avg_packets_bulk "Avg backward packets per bulk"
        double_precision bwd_avg_bulk_rate "Avg backward bulk transfer rate"
        bigint subflow_fwd_packets "Subflow forward packet count"
        bigint subflow_fwd_bytes "Subflow forward byte total"
        bigint subflow_bwd_packets "Subflow backward packet count"
        bigint subflow_bwd_bytes "Subflow backward byte total"
        bigint init_win_bytes_forward "Initial forward TCP window bytes"
        bigint init_win_bytes_backward "Initial backward TCP window bytes"
        bigint act_data_pkt_fwd "Active forward data packet count"
        bigint min_seg_size_forward "Minimum forward TCP segment size"
        double_precision active_mean "Mean active time before idle"
        double_precision active_std "Std dev active time"
        double_precision active_max "Max active time"
        double_precision active_min "Min active time"
        double_precision idle_mean "Mean idle time between bursts"
        double_precision idle_std "Std dev idle time"
        double_precision idle_max "Max idle time"
        double_precision idle_min "Min idle time"
    }

    source_files ||--o{ flows : "contains / ingests"
    attack_types ||--o{ flows : "classifies"
    flows ||--|| flow_statistics : "has detailed statistics (1:1)"
